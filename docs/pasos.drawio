<mxfile host="drawio"><diagram name="pasos"><mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l1" value="Una sola vez: consigue las credenciales" style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;rounded=1;arcSize=4;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1040" height="170" as="geometry"/></mxCell><mxCell id="l2" value="Levanta la demo" style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;rounded=1;arcSize=4;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1040" height="170" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1. API key de OpenAI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;platform.openai.com/api-keys&lt;br&gt;sk-…&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="l1"><mxGeometry x="20" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2. URL del tenant&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;https://&amp;lt;id&amp;gt;.live.dynatrace.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l1"><mxGeometry x="280" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;3. Token de Dynatrace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;myaccount → Platform tokens&lt;br&gt;dt0s16… · 3 scopes de ingesta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="l1"><mxGeometry x="540" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;4. Secrets de Codespaces&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;repo → Settings → Secrets&lt;br&gt;and variables → Codespaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="l1"><mxGeometry x="800" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;5. Abrir el Codespace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Code → Codespaces →&lt;br&gt;Create codespace on main&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l2"><mxGeometry x="20" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;6. ./start.sh&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;levanta app + collector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l2"><mxGeometry x="280" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b&gt;7. Generar tráfico&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;puerto 8000 → botón&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l2"><mxGeometry x="540" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b&gt;8. Ver en Dynatrace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Distributed Tracing&lt;br&gt;o Notebooks (DQL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;verticalAlign=middle;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="l2"><mxGeometry x="800" y="50" width="220" height="100" as="geometry"/></mxCell><mxCell id="p1p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5p6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6p7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7p8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#444444